  \CQUexactline{}{\smash{{\SimHeiLatin\heiti\fontsize{14pt}{20pt}\selectfont\thesubsubsection\hspace{0.5em}#1}}\hfil}%
  \global\CQUtextbeforeheadingfalse
}
