\newcommand{\CQUsectionTitle}[1]{%
  \refstepcounter{section}%
  \addcontentsline{toc}{section}{\protect\numberline{\thesection}#1}%
  \markboth{\thesection\hspace{0.5em}#1}{\thesection\hspace{0.5em}#1}%
  \ifCQUlayoutdebug\typeout{CQU-LAYOUT heading=section number=\thesection title=\detokenize{#1} page=\thepage pagetotal=\the\pagetotal}\fi
  \CQUexactline{\hfil}{\smash{{\SimHeiLatin\heiti\fontsize{16pt}{20pt}\selectfont\thesection\hspace{0.5em}#1}}\hfil}%
  \global\CQUtextbeforeheadingfalse
}
\newcommand{\CQUsubsection}[1]{%
